{
	"nodes":[
		{"id":"group-redirect","type":"group","x":0,"y":1220,"width":2400,"height":620,"color":"2","label":"3. Redirect and Click Tracking Flow"},
		{"id":"group-architecture","type":"group","x":0,"y":0,"width":2600,"height":600,"color":"5","label":"1. Clean Architecture and Dependency Direction"},
		{"id":"group-analytics","type":"group","x":0,"y":1940,"width":2400,"height":440,"color":"6","label":"4. Analytics Query Flow"},
		{"id":"group-create","type":"group","x":0,"y":700,"width":2400,"height":420,"color":"4","label":"2. Create Short Link Flow"},
		{"id":"group-ui-flow","type":"group","x":0,"y":2480,"width":2400,"height":440,"color":"5","label":"5. Web UI to API Flow"},
		{"id":"guide-file","type":"file","file":"PROJECT_GUIDE.md","x":-500,"y":40,"width":380,"height":780,"color":"3"},
		{"id":"architecture-web","type":"text","text":"# Web UI\n\n**Razor Pages client**\n- Dashboard and forms\n- Analytics views\n- Typed HttpClient\n- No backend project reference\n\nCommunicates through HTTP + JSON.","x":40,"y":130,"width":350,"height":340,"color":"6"},
		{"id":"architecture-api","type":"text","text":"# API\n\n**Owns**\n- HTTP routes and status codes\n- Request metadata\n- Rate limiting\n- Swagger and health\n- Dependency registration\n\n`LinksController`\n`RedirectController`\n`Program`","x":470,"y":130,"width":350,"height":340,"color":"5"},
		{"id":"architecture-application","type":"text","text":"# Application\n\n**Owns use cases**\n- Create and resolve links\n- Link lifecycle\n- Analytics classification\n- DTO mapping\n- Repository contract\n\nDoes not know EF Core or SQL Server.","x":900,"y":130,"width":350,"height":340,"color":"4"},
		{"id":"architecture-domain","type":"text","text":"# Domain\n\n**Business model**\n- `ShortenedUrl`\n- `ClickEvent`\n- Redirect eligibility rule\n\nHas no dependency on ASP.NET Core, EF Core, or SQL Server.","x":1330,"y":130,"width":350,"height":340,"color":"3"},
		{"id":"architecture-infrastructure","type":"text","text":"# Infrastructure\n\n**Implements persistence**\n- EF Core mappings\n- Repository implementation\n- Transactions\n- SQL aggregation\n- Unique conflict handling\n- Migrations","x":1760,"y":130,"width":350,"height":340,"color":"2"},
		{"id":"architecture-database","type":"text","text":"# SQL Server\n\n**Tables**\n- `ShortenedUrls`\n- `ClickEvents`\n\n**Guarantees**\n- Unique code index\n- Foreign key integrity\n- Transactional writes\n- Analytics indexes","x":2190,"y":130,"width":350,"height":340,"color":"1"},
		{"id":"create-request","type":"text","text":"# 1. Request\n\n`POST /api/links`\n\nOriginal URL, optional alias, optional expiration","x":40,"y":800,"width":280,"height":220,"color":"5"},
		{"id":"create-code","type":"text","text":"# 4. Choose code\n\nUse validated custom alias or generate seven secure random characters","x":1090,"y":800,"width":280,"height":220,"color":"4"},
		{"id":"create-insert","type":"text","text":"# 5. Try insert\n\nRepository inserts immediately. No separate check-then-insert race.","x":1440,"y":800,"width":280,"height":220,"color":"2"},
		{"id":"create-unique","type":"text","text":"# 6. Unique index\n\nSQL Server is the final authority.\n\nAlias collision → 409\nRandom collision → retry","x":1790,"y":800,"width":280,"height":220,"color":"1"},
		{"id":"create-response","type":"text","text":"# 7. Response\n\n`201 Created`\n\nReturns code, public short URL, lifecycle state, and timestamps","x":2140,"y":800,"width":220,"height":220,"color":"5"},
		{"id":"redirect-request","type":"text","text":"# 1. Visit\n\n`GET /{code}`","x":40,"y":1350,"width":260,"height":170,"color":"5"},
		{"id":"redirect-lookup","type":"text","text":"# 2. Lookup\n\nFind link by its unique code","x":380,"y":1350,"width":260,"height":170,"color":"2"},
		{"id":"redirect-404","type":"text","text":"# Missing\n\nReturn `404 Not Found`","x":380,"y":1590,"width":260,"height":150,"color":"1"},
		{"id":"redirect-410","type":"text","text":"# Unavailable\n\nReturn `410 Gone`","x":720,"y":1590,"width":260,"height":150,"color":"1"},
		{"id":"redirect-response","type":"text","text":"# 7. Redirect\n\nReturn `302 Found` to the original URL","x":2140,"y":1350,"width":220,"height":220,"color":"5"},
		{"id":"create-validation","type":"text","text":"# 2. Validate\n\n- Required URL\n- HTTP or HTTPS only\n- Alias format\n- Future expiration","x":390,"y":800,"width":280,"height":220,"color":"3"},
		{"id":"create-usecase","type":"text","text":"# 3. Use case\n\n`UrlShortenerService.CreateAsync`\n\nConstructs the domain entity and controls retry behavior","x":740,"y":800,"width":280,"height":220,"color":"4"},
		{"id":"redirect-state","type":"text","text":"# 3. Domain rule\n\nIs the link active and unexpired?","x":720,"y":1350,"width":260,"height":170,"color":"3"},
		{"id":"redirect-classify","type":"text","text":"# 4. Classify visit\n\n- Browser\n- Device\n- Referrer host\n- Country code\n- Daily visitor hash","x":1060,"y":1350,"width":280,"height":220,"color":"4"},
		{"id":"redirect-privacy","type":"text","text":"## Privacy\n\nRaw IP addresses are not stored. A daily SHA-256 fingerprint provides approximate uniqueness.","x":1060,"y":1620,"width":280,"height":150,"color":"6"},
		{"id":"redirect-transaction","type":"text","text":"# 5. Transaction\n\nAtomically increment the click counter, update last access, and insert the event","x":1420,"y":1350,"width":300,"height":220,"color":"2"},
		{"id":"redirect-write","type":"text","text":"# 6. Persist\n\n`ShortenedUrls`\n\n`ClickEvents`","x":1800,"y":1350,"width":260,"height":220,"color":"1"},
		{"id":"analytics-request","type":"text","text":"# 1. Request\n\n`GET /api/links/{code}/analytics`","x":40,"y":2040,"width":280,"height":220,"color":"5"},
		{"id":"analytics-range","type":"text","text":"# 2. Range\n\nDefault: 30 days\nMaximum: 366 days\n`from` inclusive\n`to` exclusive","x":390,"y":2040,"width":280,"height":220,"color":"3"},
		{"id":"analytics-repository","type":"text","text":"# 3. Repository\n\nBuild read-only EF Core queries restricted to link and date range","x":740,"y":2040,"width":280,"height":220,"color":"2"},
		{"id":"analytics-sql","type":"text","text":"# 4. SQL aggregation\n\n`COUNT`, `DISTINCT`, `GROUP BY`, ordering, and top-10 limits execute in SQL Server","x":1090,"y":2040,"width":300,"height":220,"color":"1"},
		{"id":"analytics-projection","type":"text","text":"# 5. Project DTOs\n\n- Daily clicks\n- Unique visitors\n- Referrers\n- Browsers\n- Devices\n- Countries","x":1460,"y":2040,"width":300,"height":220,"color":"4"},
		{"id":"analytics-response","type":"text","text":"# 6. Response\n\nReturn one analytics summary without loading all click events into application memory","x":1830,"y":2040,"width":450,"height":220,"color":"6"},
		{"id":"ui-browser","type":"text","text":"# 1. Browser\n\nUser submits a Razor form or requests the analytics page","x":40,"y":2580,"width":360,"height":220,"color":"6"},
		{"id":"ui-page-model","type":"text","text":"# 2. PageModel\n\nValidates UI input and calls the typed client. It never accesses EF Core.","x":500,"y":2580,"width":360,"height":220,"color":"5"},
		{"id":"ui-http-client","type":"text","text":"# 3. Typed HttpClient\n\nSerializes JSON, applies ApiBaseUrl, handles ProblemDetails and timeouts","x":960,"y":2580,"width":360,"height":220,"color":"4"},
		{"id":"ui-api","type":"text","text":"# 4. URLShortener.API\n\nExecutes the real use case and returns an HTTP contract","x":1420,"y":2580,"width":360,"height":220,"color":"2"},
		{"id":"ui-render","type":"text","text":"# 5. Render response\n\nPageModel supplies view data; Razor renders links, status, charts, and errors","x":1880,"y":2580,"width":420,"height":220,"color":"3"},
		{"id":"canvas-help","type":"text","text":"# Start here\n\nOpen the guide above for the detailed explanation.\n\nThe top section shows compile-time dependencies. The lower sections show runtime request flows.","x":-500,"y":980,"width":380,"height":230,"color":"3"}
	],
